# Quad-X plant and timing contract; override copter.parm.
FRAME_CLASS 1
FRAME_TYPE 1
SIM_RATE_HZ 500
SERVO1_FUNCTION 33
SERVO2_FUNCTION 34
SERVO3_FUNCTION 35
SERVO4_FUNCTION 36
MOT_PWM_MIN 1000
MOT_PWM_MAX 2000
MOT_THST_EXPO 0
# Linear thrust; normalized hover between spin min/max is (.3065625-.15)/(.95-.15).
MOT_THST_HOVER 0.195703125
MOT_HOVER_LEARN 0
MOT_BAT_VOLT_MIN 0
MOT_BAT_VOLT_MAX 0
AHRS_EKF_TYPE 3
EK3_ENABLE 1
SIM_BARO_RND 0
SIM_ACC1_RND 0
SIM_ACC2_RND 0
SIM_ACC3_RND 0
SIM_GYR1_RND 0
SIM_GYR2_RND 0
SIM_GYR3_RND 0
SIM_MAG_RND 0
# 500 Hz JSON IMU must exceed 1.8*controller rate (local INS arming check).
# 250 Hz also divides the fixed 500 Hz physics clock exactly.
SCHED_LOOP_RATE 250
MOT_SPIN_MIN 0.15
MOT_SPIN_MAX 0.95
ARMING_SKIPCHK 0
